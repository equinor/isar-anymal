FROM ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS build

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Supply ISAR with --build-context isar_source=/path/to/isar.
# Omit Git metadata so submodules and worktrees work like standalone checkouts.
COPY pyproject.toml README.md ./
COPY src/isar_anymal ./src/isar_anymal
COPY --from=isar_source pyproject.toml README.md LICENSE /src/isar/
COPY --from=isar_source src /src/isar/src
RUN uv venv /app/.venv
RUN printf 'isar @ file:///src/isar\n' > /app/isar-override.txt && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR=0.0.0+local \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR_ANYMAL=0.0.0+local \
    uv pip install --python /app/.venv/bin/python --override /app/isar-override.txt /src/isar .

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg socat \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1001 --shell /bin/bash app \
    && mkdir -p /data && chown 1001:1001 /data
COPY --from=build --chown=1001:1001 /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" IS_DOCKER=true ISAR_ROBOT_PACKAGE=isar_anymal
WORKDIR /data
EXPOSE 3000
USER 1001
CMD ["isar-start"]
