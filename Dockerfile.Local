FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4 AS build

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Supply ISAR with --build-context isar_source=/path/to/isar.
# Omit Git metadata so submodules and worktrees work like standalone checkouts.
COPY pyproject.toml README.md ./
COPY src/isar_anymal ./src/isar_anymal
COPY --from=isar_source pyproject.toml README.md LICENSE /src/isar/
COPY --from=isar_source src /src/isar/src
RUN uv venv /app/.venv
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR=2.7.2+local \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR_ANYMAL=0.0.0+local \
    uv pip install --python /app/.venv/bin/python /src/isar .

FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg socat \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1001 --shell /bin/bash app \
    && mkdir -p /data && chown 1001:1001 /data
COPY --from=build --chown=1001:1001 /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" IS_DOCKER=true ISAR_ROBOT_PACKAGE=isar_anymal
WORKDIR /data
EXPOSE 3000
USER 1001
CMD ["isar-start"]
